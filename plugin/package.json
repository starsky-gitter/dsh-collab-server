{
  "name": "dsh-collab-server",
  "version": "0.2.1",
  "description": "团队共享 AI 上下文：单条记录、按需检索、文件同步、局域网身份认证。",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "team",
    "collaboration",
    "memory",
    "sync"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "core.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
